# Database Configuration (XAMPP MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cp_user
DB_PASSWORD=your_secure_password_here
DB_NAME=codeprovenance
DATABASE_URL=mysql+pymysql://cp_user:your_secure_password_here@127.0.0.1:3306/codeprovenance?charset=utf8mb4

# Auth / JWT
SECRET_KEY=change_this_to_a_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# System Limits & Safety
MAX_REPO_SIZE_MB=250
MAX_ZIP_SIZE_MB=50
CLONE_TIMEOUT_SECONDS=60
RETENTION_DAYS=30
SCANS_PER_USER_PER_HOUR=20
